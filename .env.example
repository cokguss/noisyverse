# ================================================================
# Noisy Verse — contoh environment variables
# Salin ke .env (dev lokal) atau isi di Vercel Project Settings → Environment Variables.
# JANGAN commit file .env yang sebenarnya.
# ================================================================

# --- Supabase (WAJIB) ---
# Ambil dari Supabase Dashboard → Project Settings → API.
# GUNAKAN service_role key (server-side saja) — JANGAN pakai anon/public key,
# dan JANGAN pernah taruh key ini di frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...
# (opsional) nama tabel KV, default: kv_store
# SUPABASE_TABLE=kv_store

# --- Admin panel (WAJIB) ---
# Kunci untuk akses semua endpoint /api/admin/* (header X-Admin-Key).
# Pakai string acak yang kuat. JANGAN pakai nilai lama yang pernah bocor.
ADMIN_KEY=ganti-dengan-kunci-acak-yang-kuat

# --- Telegram bot (WAJIB untuk fitur konfirmasi pembayaran) ---
# Token dari @BotFather. Jika token lama pernah bocor, ROTASI dulu di BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ID numerik akun Telegram owner (penerima notifikasi & tombol Acc).
TELEGRAM_OWNER_ID=6359120282
# (opsional) username bot tanpa @, dipakai frontend saat serverless (cache getMe tidak persist).
# TELEGRAM_BOT_USERNAME=noisyversepayment_bot
# (opsional) secret token untuk verifikasi webhook Telegram.
# TELEGRAM_WEBHOOK_SECRET=string-acak

# --- URL publik (produksi/Vercel) ---
# Dipakai bot untuk memanggil API sendiri & untuk mendaftarkan webhook.
# Di Vercel, VERCEL_URL otomatis ada; set PUBLIC_BASE_URL untuk domain tetap.
# PUBLIC_BASE_URL=https://noisyverse.vercel.app

# --- Server lokal (opsional) ---
# PORT=3000

# --- Reverse upstream (opsional) ---
# Timeout upstream GitReverse (ms). Di Vercel Hobby maks durasi function 60s.
# REVERSE_TIMEOUT_MS=22000
# GITREVERSE_WEBSITE_API=https://www.gitreverse.com/api/reverse-website
# GITREVERSE_REPO_API=https://www.gitreverse.com/api/reverse-prompt

# --- AI providers (opsional; ada fallback default di ai.js) ---
# AI_API_URL=
# AI_API_KEY=
# UNLIAI_URL=
# METAAI_URL=
# CICI_URL=
# AI_TIMEOUT_MS=
