# ================================================================
# Noisy Verse — contoh environment variables
# Salin ke .env (dev lokal) atau isi di Vercel Project Settings → Environment Variables.
# JANGAN commit file .env yang sebenarnya.
# ================================================================

# --- Supabase (WAJIB) ---
# Ambil dari Supabase Dashboard → Project Settings → API.
# GUNAKAN service_role key (server-side saja) — JANGAN pakai anon/public key,
# dan JANGAN pernah taruh key ini di frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...
# Publishable/anon key — AMAN dikirim ke browser. Dipakai frontend untuk
# berlangganan statistik pengunjung realtime (tabel site_stats, read-only).
# Kalau dikosongkan, frontend otomatis kembali ke polling 30 detik.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# (opsional) nama tabel KV, default: kv_store
# SUPABASE_TABLE=kv_store

# --- Statistik pengunjung (opsional) ---
# Salt untuk hash SHA256 alamat IP. Ganti dengan string acak milikmu supaya
# hash tidak bisa dibalik dengan salt default yang ada di kode publik.
# VISITOR_SALT=string-acak-panjang

# --- Admin panel (WAJIB) ---
# Kunci untuk akses semua endpoint /api/admin/* (header X-Admin-Key).
# Pakai string acak yang kuat. JANGAN pakai nilai lama yang pernah bocor.
ADMIN_KEY=ganti-dengan-kunci-acak-yang-kuat

# --- Telegram bot (WAJIB untuk fitur konfirmasi pembayaran) ---
# Token dari @BotFather. Jika token lama pernah bocor, ROTASI dulu di BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ID numerik akun Telegram owner (penerima notifikasi & tombol Acc).
TELEGRAM_OWNER_ID=6359120282
# (opsional) username bot tanpa @, dipakai frontend saat serverless (cache getMe tidak persist).
# TELEGRAM_BOT_USERNAME=noisyversepayment_bot
# (opsional) secret token untuk verifikasi webhook Telegram.
# TELEGRAM_WEBHOOK_SECRET=string-acak

# --- URL publik (produksi/Vercel) ---
# Dipakai bot untuk memanggil API sendiri & untuk mendaftarkan webhook.
# Di Vercel, VERCEL_URL otomatis ada; set PUBLIC_BASE_URL untuk domain tetap.
# PUBLIC_BASE_URL=https://noisyverse.vercel.app

# --- Server lokal (opsional) ---
# PORT=3000

# --- Reverse upstream (opsional) ---
# Timeout upstream GitReverse (ms). Di Vercel Hobby maks durasi function 60s.
# REVERSE_TIMEOUT_MS=22000
# GITREVERSE_WEBSITE_API=https://www.gitreverse.com/api/reverse-website
# GITREVERSE_REPO_API=https://www.gitreverse.com/api/reverse-prompt

# --- AI providers (opsional; ada fallback default di ai.js) ---
# OPENROUTER_API_KEY = kunci OpenRouter (openrouter.ai). SANGAT disarankan: gateway
# OpenAI-compatible yang ANDAL dari datacenter Vercel, dan model gratisnya
# (minimax-m3/gemma/nemotron) sanggup output PRD LENGKAP tanpa terpotong — beda
# dari proxy gratis (garzai) yang memotong output ~4k token. Aktif jadi provider
# UTAMA bila diisi; tanpa key chain jatuh ke Groq lalu proxy gratis.
# OPENROUTER_API_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Daftar model (dipisah koma) yang dikirim sebagai fallback `models`: bila satu
# kena rate-limit upstream (429), OpenRouter otomatis pindah ke berikutnya.
# OPENROUTER_MODELS=minimax/minimax-m3:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free
# OPENROUTER_MAX_TOKENS=12000
#
# GROQ_API_KEY = kunci API resmi Groq (gratis, tanpa kartu, di console.groq.com).
# SANGAT disarankan diisi di Vercel: proxy gratis (garzai/overchat) sering stall/
# di-abort dari datacenter Vercel sehingga PRD/reverse gagal ~50%. Dengan Groq,
# AI berjalan andal & cepat. Tanpa key, chain tetap jalan pakai proxy gratis.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# Batas token output Groq. PRD lengkap butuh ruang besar; default 12000 supaya
# jawaban tidak terpotong (skema DB / daftar endpoint / KPI di akhir dokumen).
# GROQ_MAX_TOKENS=12000
# AI_API_URL=
# AI_API_KEY=
# UNLIAI_URL=
# METAAI_URL=
# CICI_URL=
# AI_TIMEOUT_MS=
